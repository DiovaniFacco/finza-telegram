# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Public bot @username (without @) and repo URL shown on the landing page (optional)
TELEGRAM_BOT_USERNAME=FinFaccoBot
GITHUB_REPO_URL=https://github.com/DiovaniFacco/finza-telegram

# --- AI (all optional; the parser works without them) ---
# Groq is the primary provider (free tier). Enables natural-language parsing,
# voice transcription (Whisper) and receipt photos (vision).
GROQ_API_KEY=
# OpenRouter is the fallback provider (optional).
OPENROUTER_API_KEY=

# --- Database ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/expenses
# Set to true only if your Postgres uses a CA-trusted cert (default: relaxed SSL for Supabase/Railway)
# DATABASE_SSL_VERIFY=false

# --- App ---
# Local: http://localhost:8000  |  Railway: auto-set from RAILWAY_PUBLIC_DOMAIN (can omit)
APP_URL=https://your-app.up.railway.app
SECRET_KEY=change-me-to-a-long-random-string
WEBHOOK_SECRET=another-random-string-for-webhook-path
APP_TZ=America/Sao_Paulo
LOG_LEVEL=INFO
